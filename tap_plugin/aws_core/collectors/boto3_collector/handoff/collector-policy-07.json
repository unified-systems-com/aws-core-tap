{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRedshift",
      "Effect": "Allow",
      "Action": [
        "redshift:DescribeClusterParameterGroups",
        "redshift:DescribeClusterSecurityGroups",
        "redshift:DescribeClusterSnapshots",
        "redshift:DescribeClusterSubnetGroups",
        "redshift:DescribeClusters",
        "redshift:DescribeEndpointAccess",
        "redshift:DescribeEventSubscriptions",
        "redshift:DescribeIntegrations",
        "redshift:DescribeQev2IdcApplications",
        "redshift:DescribeRedshiftIdcApplications",
        "redshift:DescribeScheduledActions",
        "redshift:DescribeSnapshotCopyGrants",
        "redshift:DescribeSnapshotSchedules",
        "redshift:DescribeUsageLimits"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadRedshiftServerless",
      "Effect": "Allow",
      "Action": [
        "redshift-serverless:ListNamespaces",
        "redshift-serverless:ListSnapshots",
        "redshift-serverless:ListTagsForResource",
        "redshift-serverless:ListWorkgroups"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadRekognition",
      "Effect": "Allow",
      "Action": [
        "rekognition:DescribeProjects",
        "rekognition:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadResiliencehub",
      "Effect": "Allow",
      "Action": [
        "resiliencehub:DescribeApp",
        "resiliencehub:GetPolicy",
        "resiliencehub:GetService",
        "resiliencehub:ListApps",
        "resiliencehub:ListPolicies",
        "resiliencehub:ListResiliencyPolicies",
        "resiliencehub:ListServiceFunctions",
        "resiliencehub:ListServices",
        "resiliencehub:ListSystems",
        "resiliencehub:ListTagsForResource",
        "resiliencehub:ListUserJourneys"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadResourceExplorer2",
      "Effect": "Allow",
      "Action": [
        "resource-explorer-2:GetView",
        "resource-explorer-2:ListIndexes",
        "resource-explorer-2:ListTagsForResource",
        "resource-explorer-2:ListViews"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadResourceGroups",
      "Effect": "Allow",
      "Action": [
        "resource-groups:GetTags",
        "resource-groups:ListGroups",
        "resource-groups:ListTagSyncTasks"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadRolesanywhere",
      "Effect": "Allow",
      "Action": [
        "rolesanywhere:ListCrls",
        "rolesanywhere:ListProfiles",
        "rolesanywhere:ListTagsForResource",
        "rolesanywhere:ListTrustAnchors"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadRoute53",
      "Effect": "Allow",
      "Action": [
        "route53:ListCidrCollections",
        "route53:ListHealthChecks",
        "route53:ListQueryLoggingConfigs",
        "route53:ListReusableDelegationSets",
        "route53:ListTagsForResource",
        "route53:ListTrafficPolicies",
        "route53:ListTrafficPolicyInstances"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadRoute53Profiles",
      "Effect": "Allow",
      "Action": [
        "route53profiles:GetProfile",
        "route53profiles:ListProfileAssociations",
        "route53profiles:ListProfiles",
        "route53profiles:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadRoute53Resolver",
      "Effect": "Allow",
      "Action": [
        "route53resolver:GetFirewallDomainList",
        "route53resolver:GetFirewallRuleGroup",
        "route53resolver:ListFirewallConfigs",
        "route53resolver:ListFirewallDomainLists",
        "route53resolver:ListFirewallRuleGroupAssociations",
        "route53resolver:ListFirewallRuleGroups",
        "route53resolver:ListOutpostResolvers",
        "route53resolver:ListResolverConfigs",
        "route53resolver:ListResolverDnssecConfigs",
        "route53resolver:ListResolverEndpoints",
        "route53resolver:ListResolverQueryLogConfigs",
        "route53resolver:ListResolverRules",
        "route53resolver:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadRum",
      "Effect": "Allow",
      "Action": [
        "rum:GetAppMonitor",
        "rum:ListAppMonitors"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadS3",
      "Effect": "Allow",
      "Action": [
        "s3:GetAccessPointPolicyStatus",
        "s3:GetBucketLocation",
        "s3:GetBucketPolicy",
        "s3:GetBucketPolicyStatus",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketTagging",
        "s3:GetBucketVersioning",
        "s3:GetEncryptionConfiguration",
        "s3:GetStorageLensConfigurationTagging",
        "s3:ListAccessPoints",
        "s3:ListAccessPointsForObjectLambda",
        "s3:ListAllMyBuckets",
        "s3:ListStorageLensConfigurations",
        "s3:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadS3Outposts",
      "Effect": "Allow",
      "Action": [
        "s3-outposts:ListEndpoints",
        "s3-outposts:ListOutpostsWithS3",
        "s3-outposts:ListRegionalBuckets"
      ],
      "Resource": "*"
    }
  ]
}
