{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSagemaker",
      "Effect": "Allow",
      "Action": [
        "sagemaker:DescribeAIWorkloadConfig",
        "sagemaker:DescribeAlgorithm",
        "sagemaker:DescribeCluster",
        "sagemaker:DescribeClusterSchedulerConfig",
        "sagemaker:DescribeComputeQuota",
        "sagemaker:DescribeDeviceFleet",
        "sagemaker:DescribeDomain",
        "sagemaker:DescribeEndpoint",
        "sagemaker:DescribeEndpointConfig",
        "sagemaker:DescribeExperiment",
        "sagemaker:DescribeFeatureGroup",
        "sagemaker:DescribeInferenceComponent",
        "sagemaker:DescribeInferenceExperiment",
        "sagemaker:DescribeMlflowApp",
        "sagemaker:DescribeMlflowTrackingServer",
        "sagemaker:DescribeModel",
        "sagemaker:DescribeModelCard",
        "sagemaker:DescribeModelPackage",
        "sagemaker:DescribeNotebookInstance",
        "sagemaker:DescribePartnerApp",
        "sagemaker:DescribePipeline",
        "sagemaker:DescribeProcessingJob",
        "sagemaker:DescribeProject",
        "sagemaker:DescribeSpace",
        "sagemaker:DescribeTrialComponent",
        "sagemaker:DescribeUserProfile",
        "sagemaker:ListAIWorkloadConfigs",
        "sagemaker:ListAlgorithms",
        "sagemaker:ListAppImageConfigs",
        "sagemaker:ListClusterSchedulerConfigs",
        "sagemaker:ListClusters",
        "sagemaker:ListCodeRepositories",
        "sagemaker:ListComputeQuotas",
        "sagemaker:ListDataQualityJobDefinitions",
        "sagemaker:ListDeviceFleets",
        "sagemaker:ListDevices",
        "sagemaker:ListDomains",
        "sagemaker:ListEndpointConfigs",
        "sagemaker:ListEndpoints",
        "sagemaker:ListExperiments",
        "sagemaker:ListFeatureGroups",
        "sagemaker:ListHubs",
        "sagemaker:ListHumanTaskUis",
        "sagemaker:ListImageVersions",
        "sagemaker:ListImages",
        "sagemaker:ListInferenceComponents",
        "sagemaker:ListInferenceExperiments",
        "sagemaker:ListMlflowApps",
        "sagemaker:ListMlflowTrackingServers",
        "sagemaker:ListModelBiasJobDefinitions",
        "sagemaker:ListModelCards",
        "sagemaker:ListModelExplainabilityJobDefinitions",
        "sagemaker:ListModelPackageGroups",
        "sagemaker:ListModelPackages",
        "sagemaker:ListModelQualityJobDefinitions",
        "sagemaker:ListModels",
        "sagemaker:ListMonitoringSchedules",
        "sagemaker:ListNotebookInstanceLifecycleConfigs",
        "sagemaker:ListNotebookInstances",
        "sagemaker:ListPartnerApps",
        "sagemaker:ListPipelines",
        "sagemaker:ListProcessingJobs",
        "sagemaker:ListProjects",
        "sagemaker:ListSpaces",
        "sagemaker:ListStudioLifecycleConfigs",
        "sagemaker:ListTags",
        "sagemaker:ListTrialComponents",
        "sagemaker:ListUserProfiles",
        "sagemaker:ListWorkforces",
        "sagemaker:ListWorkteams"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadScheduler",
      "Effect": "Allow",
      "Action": [
        "scheduler:GetSchedule",
        "scheduler:ListScheduleGroups",
        "scheduler:ListSchedules",
        "scheduler:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadSchemas",
      "Effect": "Allow",
      "Action": [
        "schemas:ListDiscoverers",
        "schemas:ListRegistries",
        "schemas:ListSchemas"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadSecretsmanager",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:ListSecrets"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadSecurityhub",
      "Effect": "Allow",
      "Action": [
        "securityhub:BatchGetAutomationRules",
        "securityhub:DescribeActionTargets",
        "securityhub:DescribeSecurityHubV2",
        "securityhub:GetFindingAggregator",
        "securityhub:GetInsights",
        "securityhub:ListAggregatorsV2",
        "securityhub:ListAutomationRules",
        "securityhub:ListAutomationRulesV2",
        "securityhub:ListConfigurationPolicies",
        "securityhub:ListConnectors",
        "securityhub:ListConnectorsV2",
        "securityhub:ListFindingAggregators",
        "securityhub:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadSecuritylake",
      "Effect": "Allow",
      "Action": [
        "securitylake:ListDataLakes",
        "securitylake:ListSubscribers",
        "securitylake:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadServerlessrepo",
      "Effect": "Allow",
      "Action": [
        "serverlessrepo:GetApplication",
        "serverlessrepo:ListApplications"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadServicecatalog",
      "Effect": "Allow",
      "Action": [
        "servicecatalog:DescribePortfolio",
        "servicecatalog:DescribeProductAsAdmin",
        "servicecatalog:ListApplications",
        "servicecatalog:ListAttributeGroups",
        "servicecatalog:ListPortfolios",
        "servicecatalog:ListServiceActions",
        "servicecatalog:ListTagOptions",
        "servicecatalog:ListTagsForResource",
        "servicecatalog:SearchProductsAsAdmin",
        "servicecatalog:SearchProvisionedProducts"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadServicediscovery",
      "Effect": "Allow",
      "Action": [
        "servicediscovery:ListNamespaces",
        "servicediscovery:ListServices",
        "servicediscovery:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadSes",
      "Effect": "Allow",
      "Action": [
        "ses:ListAddonInstances",
        "ses:ListAddonSubscriptions",
        "ses:ListAddressLists",
        "ses:ListConfigurationSets",
        "ses:ListContactLists",
        "ses:ListCustomVerificationEmailTemplates",
        "ses:ListDedicatedIpPools",
        "ses:ListEmailIdentities",
        "ses:ListEmailTemplates",
        "ses:ListMultiRegionEndpoints",
        "ses:ListReceiptFilters",
        "ses:ListReceiptRuleSets",
        "ses:ListTagsForResource",
        "ses:ListTenants"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadSigner",
      "Effect": "Allow",
      "Action": [
        "signer:GetSigningProfile",
        "signer:ListSigningProfiles"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadSns",
      "Effect": "Allow",
      "Action": [
        "sns:GetTopicAttributes",
        "sns:ListSubscriptions",
        "sns:ListTagsForResource",
        "sns:ListTopics"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadSqs",
      "Effect": "Allow",
      "Action": [
        "sqs:GetQueueAttributes",
        "sqs:ListQueueTags",
        "sqs:ListQueues"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadSsm",
      "Effect": "Allow",
      "Action": [
        "ssm:DescribeDocument",
        "ssm:DescribeInstanceInformation",
        "ssm:DescribeInstancePatchStates",
        "ssm:DescribeInstancePatches",
        "ssm:DescribeMaintenanceWindows",
        "ssm:DescribeParameters",
        "ssm:DescribePatchBaselines",
        "ssm:DescribePatchGroups",
        "ssm:ListAssociations",
        "ssm:ListCloudConnectors",
        "ssm:ListComplianceItems",
        "ssm:ListDocuments",
        "ssm:ListResourceComplianceSummaries",
        "ssm:ListResourceDataSync",
        "ssm:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadSso",
      "Effect": "Allow",
      "Action": [
        "sso:GetApplicationInstance",
        "sso:ListApplicationAssignments",
        "sso:ListApplicationInstances",
        "sso:ListApplicationProviders",
        "sso:ListApplications",
        "sso:ListInstances",
        "sso:ListProfileAssociations",
        "sso:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadSsoDirectory",
      "Effect": "Allow",
      "Action": [
        "sso-directory:ListGroups",
        "sso-directory:ListUsers",
        "sso-directory:SearchGroups",
        "sso-directory:SearchUsers"
      ],
      "Resource": "*"
    }
  ]
}
