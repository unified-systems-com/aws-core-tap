{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSecurityhub",
      "Effect": "Allow",
      "Action": [
        "securityhub:BatchGetAutomationRules",
        "securityhub:DescribeActionTargets",
        "securityhub:DescribeSecurityHubV2",
        "securityhub:GetFindingAggregator",
        "securityhub:GetInsights",
        "securityhub:ListAggregatorsV2",
        "securityhub:ListAutomationRules",
        "securityhub:ListAutomationRulesV2",
        "securityhub:ListConfigurationPolicies",
        "securityhub:ListConnectors",
        "securityhub:ListConnectorsV2",
        "securityhub:ListFindingAggregators",
        "securityhub:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadSecuritylake",
      "Effect": "Allow",
      "Action": [
        "securitylake:ListDataLakes",
        "securitylake:ListSubscribers",
        "securitylake:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadServerlessrepo",
      "Effect": "Allow",
      "Action": [
        "serverlessrepo:GetApplication",
        "serverlessrepo:ListApplications"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadServicecatalog",
      "Effect": "Allow",
      "Action": [
        "servicecatalog:DescribePortfolio",
        "servicecatalog:DescribeProductAsAdmin",
        "servicecatalog:ListApplications",
        "servicecatalog:ListAttributeGroups",
        "servicecatalog:ListPortfolios",
        "servicecatalog:ListServiceActions",
        "servicecatalog:ListTagOptions",
        "servicecatalog:ListTagsForResource",
        "servicecatalog:SearchProductsAsAdmin",
        "servicecatalog:SearchProvisionedProducts"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadServicediscovery",
      "Effect": "Allow",
      "Action": [
        "servicediscovery:ListNamespaces",
        "servicediscovery:ListServices",
        "servicediscovery:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadSes",
      "Effect": "Allow",
      "Action": [
        "ses:GetConfigurationSet",
        "ses:ListAddonInstances",
        "ses:ListAddonSubscriptions",
        "ses:ListAddressLists",
        "ses:ListConfigurationSets",
        "ses:ListEmailIdentities",
        "ses:ListReceiptFilters",
        "ses:ListReceiptRuleSets",
        "ses:ListTagsForResource",
        "ses:ListTenants"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadSigner",
      "Effect": "Allow",
      "Action": [
        "signer:GetSigningProfile",
        "signer:ListSigningProfiles"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadSns",
      "Effect": "Allow",
      "Action": [
        "sns:GetTopicAttributes",
        "sns:ListSubscriptions",
        "sns:ListTagsForResource",
        "sns:ListTopics"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadSqs",
      "Effect": "Allow",
      "Action": [
        "sqs:GetQueueAttributes",
        "sqs:ListQueueTags",
        "sqs:ListQueues"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadSsm",
      "Effect": "Allow",
      "Action": [
        "ssm:DescribeDocument",
        "ssm:DescribeMaintenanceWindows",
        "ssm:DescribeParameters",
        "ssm:DescribePatchBaselines",
        "ssm:ListAssociations",
        "ssm:ListCloudConnectors",
        "ssm:ListDocuments",
        "ssm:ListResourceDataSync",
        "ssm:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadSso",
      "Effect": "Allow",
      "Action": [
        "sso:GetApplicationInstance",
        "sso:ListApplicationAssignments",
        "sso:ListApplicationInstances",
        "sso:ListApplicationProviders",
        "sso:ListApplications",
        "sso:ListInstances",
        "sso:ListProfileAssociations",
        "sso:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadSsoDirectory",
      "Effect": "Allow",
      "Action": [
        "sso-directory:ListGroups",
        "sso-directory:ListUsers",
        "sso-directory:SearchGroups",
        "sso-directory:SearchUsers"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadStates",
      "Effect": "Allow",
      "Action": [
        "states:DescribeStateMachine",
        "states:ListActivities",
        "states:ListStateMachineAliases",
        "states:ListStateMachineVersions",
        "states:ListStateMachines",
        "states:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadStoragegateway",
      "Effect": "Allow",
      "Action": [
        "storagegateway:ListFileShares",
        "storagegateway:ListTagsForResource",
        "storagegateway:ListTapePools",
        "storagegateway:ListTapes",
        "storagegateway:ListVolumes"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadSynthetics",
      "Effect": "Allow",
      "Action": [
        "synthetics:DescribeCanaries",
        "synthetics:GetGroup",
        "synthetics:ListGroups",
        "synthetics:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadTag",
      "Effect": "Allow",
      "Action": [
        "tag:GetResources"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadTextract",
      "Effect": "Allow",
      "Action": [
        "textract:GetAdapter",
        "textract:ListAdapters",
        "textract:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadTimestream",
      "Effect": "Allow",
      "Action": [
        "timestream:DescribeScheduledQuery",
        "timestream:ListDatabases",
        "timestream:ListScheduledQueries",
        "timestream:ListTables",
        "timestream:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadTimestreamInfluxdb",
      "Effect": "Allow",
      "Action": [
        "timestream-influxdb:ListDbBackups",
        "timestream-influxdb:ListDbClusters",
        "timestream-influxdb:ListDbInstances",
        "timestream-influxdb:ListTagsForResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadTranscribe",
      "Effect": "Allow",
      "Action": [
        "transcribe:GetVocabulary",
        "transcribe:GetVocabularyFilter",
        "transcribe:ListCallAnalyticsCategories",
        "transcribe:ListMedicalVocabularies",
        "transcribe:ListTagsForResource",
        "transcribe:ListVocabularies",
        "transcribe:ListVocabularyFilters"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadTransfer",
      "Effect": "Allow",
      "Action": [
        "transfer:DescribeCertificate",
        "transfer:DescribeConnector",
        "transfer:DescribeServer",
        "transfer:DescribeWebApp",
        "transfer:DescribeWorkflow",
        "transfer:ListAgreements",
        "transfer:ListCertificates",
        "transfer:ListConnectors",
        "transfer:ListHostKeys",
        "transfer:ListProfiles",
        "transfer:ListServers",
        "transfer:ListTagsForResource",
        "transfer:ListUsers",
        "transfer:ListWebApps",
        "transfer:ListWorkflows"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadTranslate",
      "Effect": "Allow",
      "Action": [
        "translate:ListParallelData",
        "translate:ListTagsForResource",
        "translate:ListTerminologies"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadVerifiedpermissions",
      "Effect": "Allow",
      "Action": [
        "verifiedpermissions:GetPolicyStore",
        "verifiedpermissions:ListIdentitySources",
        "verifiedpermissions:ListPolicies",
        "verifiedpermissions:ListPolicyStoreAliases",
        "verifiedpermissions:ListPolicyStores",
        "verifiedpermissions:ListPolicyTemplates",
        "verifiedpermissions:ListTagsForResource"
      ],
      "Resource": "*"
    }
  ]
}
