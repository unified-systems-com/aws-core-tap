    },
    {
      "tap_type": "aws_core__aws_cloudhsm_cluster",
      "weight": 3,
      "why": "CloudHSM: key custody (SC-12)"
    },
    {
      "tap_type": "aws_core__aws_acm_private_ca",
      "weight": 3,
      "why": "Private CA: certificate issuance (SC-17)"
    },
    {
      "tap_type": "aws_core__aws_directoryservice_directory",
      "weight": 3,
